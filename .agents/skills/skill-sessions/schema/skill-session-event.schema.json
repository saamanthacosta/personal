{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal.local/schemas/skill-session-event.schema.json",
  "title": "Skill Session Event",
  "type": "object",
  "required": ["type", "ts", "session"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "phase_started",
        "phase_completed",
        "step_started",
        "step_completed",
        "evidence",
        "specialist_loaded",
        "loop_back",
        "note"
      ]
    },
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "session": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z-.+$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "phase_started" } } },
      "required": ["phase", "index", "total"],
      "properties": {
        "phase": { "type": "string" },
        "index": { "type": "integer", "minimum": 1 },
        "total": { "type": "integer", "minimum": 1 }
      }
    },
    {
      "if": { "properties": { "type": { "const": "phase_completed" } } },
      "required": ["phase", "duration_ms", "status"],
      "properties": {
        "phase": { "type": "string" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "status": { "type": "string", "enum": ["complete", "failed", "skipped"] }
      }
    },
    {
      "if": { "properties": { "type": { "const": "step_started" } } },
      "required": ["phase", "step", "total", "description"],
      "properties": {
        "phase": { "type": "string" },
        "step": { "type": "integer", "minimum": 1 },
        "total": { "type": "integer", "minimum": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    {
      "if": { "properties": { "type": { "const": "step_completed" } } },
      "required": ["phase", "step", "status"],
      "properties": {
        "phase": { "type": "string" },
        "step": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "enum": ["complete", "failed"] }
      }
    },
    {
      "if": { "properties": { "type": { "const": "evidence" } } },
      "required": ["source", "result"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "result": { "type": "string", "minLength": 1 }
      }
    },
    {
      "if": { "properties": { "type": { "const": "specialist_loaded" } } },
      "required": ["skill", "reason"],
      "properties": {
        "skill": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    {
      "if": { "properties": { "type": { "const": "loop_back" } } },
      "required": ["from_phase", "to_phase", "reason"],
      "properties": {
        "from_phase": { "type": "string", "minLength": 1 },
        "to_phase": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    {
      "if": { "properties": { "type": { "const": "note" } } },
      "required": ["level", "text"],
      "properties": {
        "level": { "type": "string", "enum": ["info", "warn", "error"] },
        "text": { "type": "string", "minLength": 1 }
      }
    }
  ],
  "additionalProperties": false
}