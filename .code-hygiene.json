{
  "report": "docs/code-hygiene.md",
  "exclude": [
    "**/.app/**",
    "**/dist/**",
    "**/build/**",
    "**/node_modules/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/.agents/skills/cve-scan/patterns/**",
    "**/package-lock.json",
    "**/yarn.lock",
    "**/pnpm-lock.yaml",
    "openspec/changes/archive/**/*.md",
    ".agents/skills/code-hygiene/patterns.json",
    ".agents/skills/code-hygiene/evals/evals.json",
    ".agents/skills/code-hygiene/SKILL.md",
    "docs/code-hygiene.md"
  ],
  "patterns": {
    "debug.console-log": { "severity": "warn" },
    "debug.console-warn-error": { "severity": "info" },
    "debug.breakpoint": { "severity": "blocker" },
    "debug.python-pdb": { "severity": "blocker" },
    "debug.php-dd": { "severity": "warn" },
    "todo.marker": { "severity": "info" },
    "catch.empty": { "severity": "warn" },
    "catch.silent": { "severity": "info" }
  }
}
